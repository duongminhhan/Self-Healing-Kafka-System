# Copy to env/prod.env and replace every production endpoint and secret.
APP_ENV=prod

KAFKA_CONNECT_URL=https://kafka-connect.example.internal:8083
KAFKA_CONNECT_TLS_VERIFY=true
MSSQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=mssql.example.internal,1433;Database=self_healthy_kafka;UID=self_healthy_kafka;PWD=replace-me;Encrypt=yes;TrustServerCertificate=no
MSSQL_CONNECTION_TIMEOUT_SECONDS=5

KC_REQUEST_TIMEOUT=30
KC_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
CONNECTOR_HEALTH_POLLING_ENABLED=true
POLL_INTERVAL_SECONDS=600

GRAFANA_WEBHOOK_ENABLED=true
GRAFANA_WEBHOOK_HOST=0.0.0.0
GRAFANA_WEBHOOK_PORT=8080
GRAFANA_WEBHOOK_PATH=/webhooks/grafana
GRAFANA_WEBHOOK_AUTH_MODE=bearer
GRAFANA_WEBHOOK_SECRET=replace-me
GRAFANA_WEBHOOK_SIGNATURE_HEADER=X-Grafana-Alerting-Signature
GRAFANA_WEBHOOK_TIMESTAMP_HEADER=X-Grafana-Alerting-Timestamp
GRAFANA_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
GRAFANA_WEBHOOK_DEDUPE_TTL_SECONDS=600
GRAFANA_WEBHOOK_QUEUE_SIZE=1000
GRAFANA_WEBHOOK_WORKER_COUNT=4
GRAFANA_WEBHOOK_RECOVERY_FOLLOWUP_SECONDS=30

CHAT_API_ENABLED=true
CHAT_API_PATH_PREFIX=/api/v1
CHAT_API_TOKEN=replace-in-prod-env
CHAT_API_DEFAULT_LIMIT=100
CHAT_API_MAX_LIMIT=500

OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=replace-with-tool-capable-model
OLLAMA_REQUEST_TIMEOUT_SECONDS=60
OLLAMA_THINK=true
OLLAMA_MAX_TOKENS=256
OLLAMA_CONTEXT_LOG_LIMIT=3

CHAT_ANALYTICS_ENABLED=false
CHAT_ANALYTICS_TIMEZONE=Asia/Ho_Chi_Minh
HF_CHAT_ENDPOINT_URL=
HF_CHAT_TOKEN=
HF_CHAT_MODEL_ID=
HF_CHAT_REQUEST_TIMEOUT_SECONDS=30
CHAT_CONVERSATION_TTL_SECONDS=1800
CHAT_CONVERSATION_MAX_ENTRIES=500

# Optional approved-runbook RAG. Use a Qdrant Cloud Inference model supported
# by this cluster and set QDRANT_EMBEDDING_SIZE to that model's exact dimension.
RAG_ENABLED=false
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=healing_runbooks_v1
QDRANT_DENSE_COLLECTION=healing_runbooks_v1
QDRANT_HYBRID_COLLECTION=healing_runbooks_v2
QDRANT_EMBEDDING_MODEL=
QDRANT_EMBEDDING_SIZE=384
RAG_SEARCH_MODE=dense
RAG_RETRIEVAL_MODE=dense
RAG_HYBRID_SHADOW_ENABLED=false
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse
QDRANT_DENSE_EMBEDDING_MODEL=
QDRANT_SPARSE_EMBEDDING_MODEL=qdrant/bm25
RAG_TOP_K=5
RAG_FINAL_TOP_K=5
RAG_CANDIDATE_LIMIT=15
RAG_MAX_CHUNKS_PER_RUNBOOK=2
RAG_DIVERSIFICATION_ENABLED=
RAG_REQUEST_TIMEOUT_SECONDS=10
RAG_MAX_RETRIES=1
RAG_SCORE_THRESHOLD=0.55
RAG_DENSE_SCORE_THRESHOLD=
RAG_SPARSE_SCORE_THRESHOLD=
RAG_HYBRID_DENSE_CANDIDATES=15
RAG_HYBRID_SPARSE_CANDIDATES=15
RAG_FUSION_METHOD=rrf
RAG_FUSION_LIMIT=15
RAG_HYBRID_DENSE_WEIGHT=1
RAG_HYBRID_SPARSE_WEIGHT=1
RAG_HYBRID_WEIGHTED_RRF_FALLBACK_TO_EQUAL=false
RAG_HYBRID_FALLBACK_TO_DENSE=false
RAG_EVIDENCE_GATE_ENABLED=
RAG_EVIDENCE_MIN_SCORE=0
RAG_EVIDENCE_MIN_MARGIN=0
RAG_EVIDENCE_REQUIRE_ANCHOR_MATCH=true
RAG_HYBRID_SHADOW_SAMPLE_RATE=0
RAG_HYBRID_TIMEOUT_SECONDS=10
RAG_HYBRID_SHADOW_QUEUE_SIZE=32
RAG_MAX_CHUNK_CHARS=2400
RAG_MAX_CONTEXT_CHARS=8000
RAG_ENVIRONMENT=prod
RAG_TENANT_ID=default
RAG_DIAGNOSTICS_ENABLED=false

FAILURE_CONFIRM_CHECKS=3
TASK_RESTART_MAX_ATTEMPTS=3
CONNECTOR_RESTART_MAX_ATTEMPTS=1
POST_RESTART_WAIT_SECONDS=30
RECOVERY_HEALTHY_CONFIRM_SECONDS=60
RECREATE_VERIFY_WAIT_SECONDS=30
RECREATE_KEEP_BASE_CONNECTOR=false
SCN_POLL_INTERVAL_SECONDS=60

LOG_LEVEL=INFO

APP_ENV=prod

KAFKA_CONNECT_URL=https://kafka-connect.example.internal:8083
KAFKA_CONNECT_TLS_VERIFY=true
KAFKA_BOOTSTRAP_SERVERS=kafka-1.example.internal:9092,kafka-2.example.internal:9092
MSSQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=mssql.example.internal,1433;Database=self_healthy_kafka;UID=self_healthy_kafka;PWD=replace-me;Encrypt=yes;TrustServerCertificate=no
MSSQL_CONNECTION_TIMEOUT_SECONDS=5

KC_REQUEST_TIMEOUT=30
KC_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
CONNECTOR_HEALTH_POLLING_ENABLED=true
POLL_INTERVAL_SECONDS=600

GRAFANA_WEBHOOK_ENABLED=true
GRAFANA_WEBHOOK_HOST=0.0.0.0
GRAFANA_WEBHOOK_PORT=8080
GRAFANA_WEBHOOK_PATH=/webhooks/grafana
GRAFANA_WEBHOOK_AUTH_MODE=bearer
GRAFANA_WEBHOOK_SECRET=replace-me
GRAFANA_WEBHOOK_SIGNATURE_HEADER=X-Grafana-Alerting-Signature
GRAFANA_WEBHOOK_TIMESTAMP_HEADER=X-Grafana-Alerting-Timestamp
GRAFANA_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
GRAFANA_WEBHOOK_DEDUPE_TTL_SECONDS=600
GRAFANA_WEBHOOK_QUEUE_SIZE=1000
GRAFANA_WEBHOOK_WORKER_COUNT=4
GRAFANA_WEBHOOK_RECOVERY_FOLLOWUP_SECONDS=30
MONITORING_INVENTORY_REFRESH_SECONDS=60

FAILURE_CONFIRM_CHECKS=3
TASK_RESTART_MAX_ATTEMPTS=3
CONNECTOR_RESTART_MAX_ATTEMPTS=1
POST_RESTART_WAIT_SECONDS=30
RECOVERY_HEALTHY_CONFIRM_SECONDS=60
RECREATE_VERIFY_WAIT_SECONDS=30
RECREATE_KEEP_BASE_CONNECTOR=false
SCN_POLL_INTERVAL_SECONDS=60

TOPIC_LAG_TOPIC_IDLE_ENABLED=true
TOPIC_LAG_EVENT_CAPTURE_ENABLED=false
TOPIC_IDLE_THRESHOLD_SECONDS=180
TOPIC_IDLE_POLL_INTERVAL_SECONDS=30
TOPIC_EVENT_CAPTURE_LAG_THRESHOLD_MS=60000
LOG_LEVEL=INFO

PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_METRICS_HOST=0.0.0.0
PROMETHEUS_METRICS_PORT=9108
METRICS_SYNC_INTERVAL_SECONDS=60
